# ---------------------------------------------------------------------------
# FitMind AI — backend environment
#
# Copy to `.env` and fill in. Never commit `.env`.
# Placeholder-looking values (`your_...`, `replace_with...`, `changeme`, `<...>`)
# are treated as UNSET by config/env.js, so a half-filled file fails loudly at
# boot instead of misbehaving at runtime.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8000
# error | warn | info | debug   (production defaults to info)
LOG_LEVEL=debug
# Set to 1 behind a proxy/load balancer (Render, Railway, Fly, nginx) so req.ip
# is the real client IP and rate limiting is per-visitor, not per-proxy.
TRUST_PROXY=0

# --- Database --------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/fitmind
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/fitmind?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fitmind

# --- Auth ------------------------------------------------------------------
# REQUIRED. Minimum 32 characters is enforced in production.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=30d
# bcrypt cost factor. 12 is a good 2026 default; lower only for local speed.
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of browser origins. `*.vercel.app` preview URLs are
# accepted automatically. Requests with no Origin header (server-to-server,
# curl, uptime pingers) are always allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- AI provider -----------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# --- Pricing ---------------------------------------------------------------
# Rupees. Admin approval grants this amount's premium period.
PREMIUM_PRICE_INR=499
PREMIUM_PERIOD_DAYS=30
PAYMENT_HANDLE=ayushbhardwaj1600@okhdfcbank
PAYMENT_QR_IMAGE_URL=/payment-qr.png
