# Frontend environment (Vite). Copy to `.env.local` for local dev.
#
# Must be the FULL base URL including the /api suffix — src/api/axios.js uses it
# verbatim as the axios baseURL. Vite only exposes variables prefixed VITE_, and
# it inlines them at BUILD time, so changing this on Vercel requires a redeploy.
#
# Local:      http://localhost:8000/api
# Production: https://fitmind-ai-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api
